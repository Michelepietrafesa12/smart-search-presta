{
  "name": "SmartSearch Analytics",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smartsearch-analytics",
        "options": {
          "responseMode": "onReceived"
        }
      },
      "id": "webhook-receiver",
      "name": "Webhook SmartSearch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "smartsearch-analytics"
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "search",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "search",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "click",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "click",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "conversion",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "conversion",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "no_results",
              "conditions": {
                "options": { "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "no_results",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "id": "router",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/search_events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"search\",\n  \"query\": \"{{ $json.query }}\",\n  \"results_count\": {{ $json.results_count }},\n  \"shop_id\": \"{{ $json.shop_id }}\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"user_agent\": \"{{ $json.user_agent }}\",\n  \"device_type\": \"{{ $json.device_type }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {}
      },
      "id": "insert-search",
      "name": "Insert Search Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/click_events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"click\",\n  \"query\": \"{{ $json.query }}\",\n  \"product_id\": {{ $json.product_id }},\n  \"product_name\": \"{{ $json.product_name }}\",\n  \"position\": {{ $json.position }},\n  \"shop_id\": \"{{ $json.shop_id }}\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {}
      },
      "id": "insert-click",
      "name": "Insert Click Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/conversion_events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"conversion\",\n  \"query\": \"{{ $json.query }}\",\n  \"product_id\": {{ $json.product_id }},\n  \"product_name\": \"{{ $json.product_name }}\",\n  \"order_id\": {{ $json.order_id }},\n  \"revenue\": {{ $json.revenue }},\n  \"shop_id\": \"{{ $json.shop_id }}\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {}
      },
      "id": "insert-conversion",
      "name": "Insert Conversion Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/search_events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"no_results\",\n  \"query\": \"{{ $json.query }}\",\n  \"results_count\": 0,\n  \"shop_id\": \"{{ $json.shop_id }}\",\n  \"session_id\": \"{{ $json.session_id }}\",\n  \"user_agent\": \"{{ $json.user_agent }}\",\n  \"device_type\": \"{{ $json.device_type }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {}
      },
      "id": "insert-no-results",
      "name": "Insert No Results Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 550]
    }
  ],
  "connections": {
    "Webhook SmartSearch": {
      "main": [
        [{ "node": "Route by Event Type", "type": "main", "index": 0 }]
      ]
    },
    "Route by Event Type": {
      "main": [
        [{ "node": "Insert Search Event", "type": "main", "index": 0 }],
        [{ "node": "Insert Click Event", "type": "main", "index": 0 }],
        [{ "node": "Insert Conversion Event", "type": "main", "index": 0 }],
        [{ "node": "Insert No Results Event", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "pinData": {}
}
